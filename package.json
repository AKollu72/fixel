{
  "name": "fixel",
  "version": "0.2.0",
  "description": "CI guard for AI-generated React — token-level drift detection against Figma, prohibited-pattern enforcement, and findings posted back to the design canvas.",
  "license": "FSL-1.1-MIT",
  "author": "Amrutha Kollu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKollu72/fixel.git"
  },
  "homepage": "https://github.com/AKollu72/fixel",
  "keywords": [
    "figma",
    "design-system",
    "react",
    "tailwind",
    "mui",
    "drift",
    "cli",
    "codegen",
    "design-tokens",
    "verification",
    "ai-codegen",
    "drift-detection",
    "mcp",
    "ci"
  ],
  "bin": {
    "fixel": "fixel-bin.js",
    "fixel-mcp": "fixel-mcp-bin.js"
  },
  "main": "./dist/index.js",
  "files": [
    "fixel-bin.js",
    "fixel-mcp-bin.js",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE",
    "README.md",
    "fixel.config.example.json"
  ],
  "scripts": {
